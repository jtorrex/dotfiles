# IDE and editor files
.vscode/
.idea/
*.swp
*~
*.zwc
*.zwc.old

# Neovim
.config/nvim/bundle/

# Pi
.config/pi/agent/sessions
.config/pi/agent/auth.json

# Herdr (runtime state lives in the config dir)
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/session.json
.config/herdr/session-*.json
.config/herdr/session-history.json
.config/herdr/release-notes.json

# Machine-local files (paths differ per host)
.config/go
.config/gtk-3.0/bookmarks
.config/git/allowed_signers

# MPD
.config/mpd/database
.config/mpd/log
.config/mpd/pid
.config/mpd/playlists/
.config/mpd/state
.config/mpd/sticker.sql
.config/mpd/db

# Logs and temporary files
.config/ncmpcpp/error.log
.config/alacritty/alacritty.yml.*.bak
.config/zsh/antidote
.config/zsh/.zshrc.zwc

# Private directories and files
.config/newsboat/urls
.config/zsh/histfile
.config/zsh/histfile.bkp

# Private scripts and sensitive data
.local/bin/private/*
!.local/bin/private/secure/
.local/bin/private/secure/*
!.local/bin/private/secure/*.gpg

# Ignore all .env files
**/*.env

# But track example env files
!**/*.env.example

# Regenerated files
.config/zsh/zsh_plugins.zsh
lazy-lock.json
node_modules/
