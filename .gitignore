.vscode/
.idea/
*.swp
*~
*.zwc
*.zwc.old

# Neovim
.config/nvim/bundle/

# Pi
.config/pi/agent/sessions
.config/pi/agent/auth.json

# MPD
.config/mpd/database
.config/mpd/log
.config/mpd/pid
.config/mpd/playlists/
.config/mpd/state
.config/mpd/sticker.sql
.config/mpd/db

# Logs and temporary files
.config/ncmpcpp/error.log
.config/alacritty/alacritty.yml.*.bak
