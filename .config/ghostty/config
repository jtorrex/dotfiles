font-family = IoskeleyMonoTerm
theme = Dracula+
font-size = 14
cursor-style = block
cursor-style-blink = true
adjust-cell-height = 10%
background = #000000
background-opacity = 1
window-padding-balance = true
copy-on-select = clipboard

keybind = shift+enter=send_string:\u001b[13;2u
keybind = ctrl+enter=send_string:\u001b[13;5u
