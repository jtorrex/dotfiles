# Ghostty theme
# Adaptive light/dark themes follow the system appearance via the XDG
# desktop portal (org.freedesktop.appearance color-scheme), which on sway
# is driven by `gsettings org.gnome.desktop.interface color-scheme`.
# Toggle with: $mod+Shift+t (see .local/bin/toggle-theme)
theme = light:GitHub Light Default,dark:Catppuccin Mocha
# Shell Integration
shell-integration = zsh
quit-after-last-window-closed = true

# Font family
font-family = IoskeleyMonoTerm
font-style = Regular
font-style-italic = Regular Italic
font-style-bold = Bold
font-style-bold-italic = Bold Italic
adjust-cell-height = 10%

# Font Size
font-size = 12

# Opacity of split windows
unfocused-split-opacity = 0.97

# Keep the background fully opaque
# NOTE: an explicit `background = #RRGGBB` would override the theme's
# background color and break the light theme, so it stays unset here.
background-opacity = 1.0

# Cursor Style
cursor-style-blink = true
cursor-style = block

# Clipboard settings
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# Window settings
window-padding-balance = true

# Keybindings
keybind = ctrl+enter=text:\r
keybind = shift+enter=text:\n
